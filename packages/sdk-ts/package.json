{
  "name": "@runport/sdk",
  "version": "1.0.1",
  "description": "TypeScript / JavaScript client SDK for Runport universal LLM and workflow benchmarking platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-strip-types --test tests/client.test.ts"
  },
  "keywords": [
    "llm",
    "benchmarking",
    "observability",
    "evals",
    "runport",
    "ai-agents",
    "budget-caps"
  ],
  "author": "Runport Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

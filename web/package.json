{
  "name": "runport-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:landing": "vite --config vite.landing.config.ts",
    "build:landing": "tsc && vite build --config vite.landing.config.ts",
    "preview:landing": "vite preview --config vite.landing.config.ts",
    "dev:docs": "vite --config vite.docs.config.ts",
    "build:docs": "tsc && vite build --config vite.docs.config.ts",
    "preview:docs": "vite preview --config vite.docs.config.ts",
    "build:site": "npm run build:landing && vite build --config vite.docs.config.ts --outDir ../dist-landing/docs --emptyOutDir",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts"
  },
  "dependencies": {
    "framer-motion": "^14.9.0",
    "lucide-react": "^0.363.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6"
  }
}

{
  "mcpServers": {
    "runport": {
      "command": "runport",
      "args": ["mcp"],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "runport-remote": {
      "url": "http://127.0.0.1:8000/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${env:RUNPORT_API_KEY}"
      }
    }
  }
}
